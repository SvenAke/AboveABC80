**setup.sh**

#!/usr/bin/env bash
set -euo pipefail

LOGFILE="setup.log"

log() {
echo -e "\033[1;32m[SETUP]\033[0m $1"
echo "[SETUP] $1" >> "$LOGFILE"
}

log "Startar installation…"

log "Uppdaterar systemet"
sudo apt update && sudo apt upgrade -y

log "Installerar grundläggande utvecklingsverktyg"
sudo apt install -y \
build-essential \
git \
curl \
wget \
unzip \
zip \
pkg-config

log "Installerar CMake och Ninja"
sudo apt install -y cmake ninja-build

log "Installerar OpenJDK 21"
sudo apt install -y openjdk-21-jdk

log "Installerar Kotlin"
if ! command -v kotlin >/dev/null 2>&1; then
sudo snap install --classic kotlin
else
log "Kotlin redan installerat"
fi

log "Installerar Gradle"
if ! command -v gradle >/dev/null 2>&1; then
sudo snap install --classic gradle
else
log "Gradle redan installerat"
fi

log "Installerar Node.js via NVM"
if [ ! -d "$HOME/.nvm" ]; then
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
source "$HOME/.bashrc"
nvm install --lts
else
log "NVM redan installerat"
source "$HOME/.bashrc"
fi

log "Installerar Python + pip + analysbibliotek"
sudo apt install -y python3 python3-pip
pip install --upgrade pip
pip install numpy scipy matplotlib soundfile

log "Installerar SDL2 + multimedia"
sudo apt install -y \
libsdl2-dev \
libsdl2-mixer-dev \
libsdl2-ttf-dev \
libsdl2-image-dev

log "Installerar PulseAudio och PortAudio dev headers"
sudo apt install -y libpulse-dev portaudio19-dev

log "Installerar OpenGL"
sudo apt install -y mesa-common-dev libgl1-mesa-dev

log "Installerar FFmpeg"
sudo apt install -y ffmpeg

log "Installerar VS Code"
if ! command -v code >/dev/null 2>&1; then
sudo snap install --classic code
else
log "VS Code redan installerat"
fi

log "Installerar JetBrains Toolbox"
if [ ! -f "/usr/local/bin/jetbrains-toolbox" ]; then
TB_URL=$(curl -s https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release \
| grep -oP '"linux":\{"link":"\K[^"]+')
wget -O toolbox.tar.gz "$TB_URL"
tar -xzf toolbox.tar.gz
TB_DIR=$(find . -maxdepth 1 -type d -name "jetbrains-toolbox-*")
sudo mv "$TB_DIR/jetbrains-toolbox" /usr/local/bin/
rm -rf "$TB_DIR" toolbox.tar.gz
else
log "JetBrains Toolbox redan installerat"
fi

log "Konfigurerar Git"
git config --global user.name "SvenÅke"
git config --global user.email "example@example.com"
git config --global pull.rebase false

log "Klart! Din utvecklingsmiljö är redo."

**build_fuse.sh**

#!/usr/bin/env bash
set -euo pipefail

FUSE_VERSION="1.6.0"
LIBSPECTRUM_VERSION="1.5.0"
UTILS_VERSION="1.4.3"

FUSE_TARBALL="fuse-${FUSE_VERSION}.tar.gz"
LIBSPEC_TARBALL="libspectrum-${LIBSPECTRUM_VERSION}.tar.gz"
UTILS_TARBALL="fuse-utils-${UTILS_VERSION}.tar.gz"

FUSE_URL="https://sourceforge.net/projects/fuse-emulator/files/fuse/${FUSE_VERSION}/${FUSE_TARBALL}/download"
LIBSPEC_URL="https://sourceforge.net/projects/fuse-emulator/files/libspectrum/${LIBSPECTRUM_VERSION}/${LIBSPEC_TARBALL}/download"
UTILS_URL="https://sourceforge.net/projects/fuse-emulator/files/fuse-utils/${UTILS_VERSION}/${UTILS_TARBALL}/download"

log() {
    echo -e "\033[1;36m[FUSE]\033[0m $1"
}

log "Installerar beroenden…"
sudo apt update
sudo apt install -y \
    build-essential \
    pkg-config \
    libsdl2-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libxml2-dev \
    libasound2-dev \
    libpulse-dev \
    libportaudio2 \
    portaudio19-dev \
    zlib1g-dev \
    libpng-dev \
    libbz2-dev \
    liblzo2-dev \
    libcurl4-openssl-dev \
    libreadline-dev \
    libtool \
    automake \
    autoconf \
    wget \
    xz-utils

mkdir -p fuse-build
cd fuse-build

# ------------------------------
# LIBSPECTRUM
# ------------------------------
log "Hämtar libspectrum…"
if [ ! -f "$LIBSPEC_TARBALL" ]; then
    wget -O "$LIBSPEC_TARBALL" "$LIBSPEC_URL"
else
    log "libspectrum tarball redan nedladdad"
fi

if [ ! -d "libspectrum-${LIBSPECTRUM_VERSION}" ]; then
    log "Packar upp libspectrum…"
    tar -xzf "$LIBSPEC_TARBALL"
fi

cd "libspectrum-${LIBSPECTRUM_VERSION}"

log "Bygger libspectrum…"
autoreconf -fiv || true
./configure --prefix=/usr/local
make -j"$(nproc)"
sudo make install
sudo ldconfig

cd ..

# ------------------------------
# FUSE-UTILS
# ------------------------------
log "Hämtar fuse-utils…"
if [ ! -f "$UTILS_TARBALL" ]; then
    wget -O "$UTILS_TARBALL" "$UTILS_URL"
else
    log "fuse-utils tarball redan nedladdad"
fi

if [ ! -d "fuse-utils-${UTILS_VERSION}" ]; then
    log "Packar upp fuse-utils…"
    tar -xzf "$UTILS_TARBALL"
fi

cd "fuse-utils-${UTILS_VERSION}"

log "Bygger fuse-utils…"
autoreconf -fiv || true
./configure --prefix=/usr/local
make -j"$(nproc)"
sudo make install

cd ..

# ------------------------------
# FUSE
# ------------------------------
log "Hämtar Fuse…"
if [ ! -f "$FUSE_TARBALL" ]; then
    wget -O "$FUSE_TARBALL" "$FUSE_URL"
else
    log "Fuse tarball redan nedladdad"
fi

if [ ! -d "fuse-${FUSE_VERSION}" ]; then
    log "Packar upp Fuse…"
    tar -xzf "$FUSE_TARBALL"
fi

cd "fuse-${FUSE_VERSION}"

log "Konfigurerar Fuse…"
autoreconf -fiv || true
./configure --prefix=/usr/local

log "Kompilerar Fuse…"
make -j"$(nproc)"

log "Installerar Fuse…"
sudo make install

log "Fuse + libspectrum + fuse-utils är installerat!"
log "Starta emulatorn med: fuse"
log "Verktyg tillgängliga: tzx2wav, wav2tzx, tzxlist, tape2wav, wav2tap, m.fl."
