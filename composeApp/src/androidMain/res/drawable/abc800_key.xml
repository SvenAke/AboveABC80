<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient android:angle="270" android:startColor="#D5C79F" android:endColor="#AB9A72" />
            <stroke android:width="1dp" android:color="#887B5C" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="4dp" />
                    <solid android:color="#A89972" />
                </shape>
            </item>
            <item android:left="3dp" android:right="3dp" android:top="2dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <gradient android:angle="270" android:startColor="#F4EACB" android:endColor="#DED0A6" />
                    <stroke android:width="1dp" android:color="#C1B28B" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
