plm2d: DO;
$include(:f2:plm2d.ipx)

FoldConstantExpr: procedure public;
	declare arithOp byte,
		(lhsAcc, lhsAccFlag, rhsAcc, rhsAccFlag) address,
		operand byte,
		constVal address,
		(resAttrib, resOpFlag) byte;

	CanFoldOperand: procedure(validationRule, operandFlag) byte;
	    declare validationRule byte, operandFlag address;
	    if validationRule = 0 then
	    do;
		if tx2Aux2b(operand) <> 4 then
		    return FALSE;
	    end;
	    else if validationRule <> 3 then
	    do;
		if tx2Aux2b(operand) <> 8 then
		    return FALSE;
		if operandFlag <> 0 then
		do;
		    if validationRule = 2 then
			    return FALSE;
		    if validationRule = 4 then
		    do;
			if lhsAccFlag <> 0 then
			   return FALSE;
		    end;
		    else if validationRule = 5 then
		    do;
			if lhsAccFlag <> rhsAccFlag then
			   return FALSE;
		    end;
		end;
	    end;
	    else if operandFlag = 4000h then
		    return FALSE;
	    return TRUE;
	end;


	evalConst: procedure address;
	    do case arithOp;
		return lhsAcc;
		return lhsAcc + rhsAcc;
		return lhsAcc - rhsAcc;
		return lhsAcc * rhsAcc;
		return lhsAcc / rhsAcc;
		return lhsAcc mod rhsAcc;
		return lhsAcc and rhsAcc;
		return lhsAcc or rhsAcc;
		return lhsAcc xor rhsAcc;
		return lhsAcc + rhsAcc;
		return lhsAcc + rhsAcc;
		return lhsAcc + rhsAcc + rhsAcc;
		return lhsAcc + rhsAcc;
		return -lhsAcc;
		return not lhsAcc;
		return low(lhsAcc);
		return high(lhsAcc);
		return lhsAcc;
	    end;
	end;

	DetermineResultType: procedure;
	    if curOp = T2$MEMBER and tx2Aux2b(tx2Left(tx2qp)) = 0ah then
	    do;
		resAttrib = tx2Aux1b(tx2Right(tx2qp));
		resOpFlag = 0Ah;
	    end;
	    else 
		do case constFoldRules(arithOp) and 7;
		    do;
			resAttrib = 0;
			resOpFlag = 8;
		    end;
		    do;
			if tx2Aux1b(tx2Left(tx2qp)) = 0 and tx2Aux1b(tx2Right(tx2qp)) = 0 then
			   resAttrib = 0;
			else
			   resAttrib = 1;
			resOpFlag = 8;
		    end;
		    do;
			resAttrib = 1;
			resOpFlag = 8;
		    end;
		    do;
			resAttrib = tx2Aux1b(tx2Left(tx2qp));
			resOpFlag = tx2Aux2b(tx2Left(tx2qp));
		    end;
		    do;
			resAttrib = tx2Aux1b(tx2Right(tx2qp));
			resOpFlag = tx2Aux2b(tx2Right(tx2qp));
		    end;
		    do;
			resAttrib = Sub$5748(tx2Aux1b(tx2Right(tx2qp)));
			resOpFlag = 8;
		    end;
		end;
	    if lhsAccFlag = rhsAccFlag then
		curInfo$p = 0;
	    else if rhsAccFlag = 0  then
		curInfo$p = tx2Left(tx2Left(tx2qp));
	    else
		curInfo$p = tx2Left(tx2Right(tx2qp));
	end;

/* FoldConstantExpr */
	arithOp = curOp - 12h;
	operand = tx2Left(tx2qp);
	call GetOperandValue(operand, .lhsAcc, .lhsAccFlag);
	if CanFoldOperand(shr(constFoldRules(arithOp), 6), lhsAccFlag) then
	do;
		operand = tx2Right(tx2qp);
		call GetOperandValue(operand, .rhsAcc, .rhsAccFlag);
		if CanFoldOperand(shr(constFoldRules(arithOp), 3) and 7h, rhsAccFlag) then
		do;
			call DecrementExprRefs;
			constVal = evalConst;
			call DetermineResultType;
			if resAttrib = 0 and resOpFlag = 8 then
				constVal = constVal and 0FFh;
			call CreateConstantOrIdNode(constVal, curInfo$p, resAttrib, resOpFlag);
			nodeControlFlags = nodeControlMap(curOp := tx2Type(tx2qp));
		end;
	end;
end;


OptimiseExpression: procedure public;

	ApplyStepOptimisation: procedure(stepIdx, left, right) byte;
		declare stepIdx byte, left byte, right byte,
			optResult byte, (acc, accFlag) address,
			(curStepActions, i) byte, p address;


		ExpectedAttr: procedure(nodeLoc) byte;
			declare nodeLoc byte;
			if (curStepActions and 40h) <> 0 then
			do;
				if tx2Aux1b(nodeLoc) = 1 then
					return TRUE;
				if tx2Aux1b(nodeLoc) = 3 then
					return TRUE;
				return FALSE;
			end;
			else if tx2Aux1b(nodeLoc) = 0 then
				return TRUE;
			else if tx2Aux1b(nodeLoc) = 2 then
				return TRUE;
			else if tx2Aux1b(nodeLoc) = 8 then
				return TRUE;
			else
				return FALSE;
		end;

		TryEliminateCopyAssignment: procedure;
			declare (i, j) byte;
			i = tx2qp + 1;
			do while tx2Type(i) = T2$OPTBACKREF and i < bC1BF;
				i = i + 1;  
			end;
			j = tx2qp;
			if tx2Type(i) = T2$STORE then
			do;
				if right= tx2Left(i) then
				do;
					if tx2Right(i) = j then
					do;
						if tx2Cnt(j) = 1 then
						do;
							optResult = 6;
							tx2Type(i) = T2$SEMICOLON;
							tx2Cnt(j) = 0;
							tx2Cnt(right) = tx2Cnt(right) - 1;  
						end;
					end;
				end;
			end;
		end;

		ValidateOptimisationStep: procedure  byte;
			if accFlag <> 0 or (curOp < T2$BASED and tx2Aux2b(left) <> 8) then
				return FALSE;
			if (curStepActions and 20h) <> 0 then
				if not ExpectedAttr(right) then
					return FALSE;
			if (curStepActions and 1) <> 0 then
				if ExpectedAttr(left) <> ExpectedAttr(right) then
					return FALSE;
			if (curStepActions and 4) <> 0 then
			do;
				if (curStepActions and 8) <> 0 then
					if acc <> 0 then
						return TRUE;
					else
						return FALSE;
				p = commonConstants(shr(peepholePatterns(stepIdx), 3));
				if p <> acc then
					return FALSE;
				if (curStepActions and 80h) <> 0 then
					call TryEliminateCopyAssignment;
				return 0FFh;
			end;
			if (curStepActions and 40h) = 0 then
			do;
				p = commonConstants(shr(peepholePatterns(stepIdx), 3));
				optResult = acc mod p;
				return TRUE;
			end;
			else if acc <= 4 then
			do;
				optResult = acc;
				return TRUE;
			end;
			else
				return FALSE;
		end;

		ApplyTransformation: procedure;
			declare (type, j, k) byte;
			stepIdx = stepIdx - 1;
			type = step2ActionTable(stepIdx) + optResult;
			j = peepholePatterns(stepIdx) and 3;
			if type = 0ADh then
			do;
				if j = 0 then
					acc = 0;
				call DecrementExprRefs;
				curStepActions = 0;
				k = 1;
				if curOp <> T2$STAR then
				    if curOp <> T2$SLASH then
					if curOp <> T2$MOD then
					    if acc < 100h then
						if ExpectedAttr(left) then
						    if right = 0 then
							k = 0;
						    else if ExpectedAttr(left) then
							k = 0;
				call CreateConstantOrIdNode(acc, 0, k, 8);
			end;
			else
			do;
				if j = 1 then
				do;
					tx2Left(tx2qp) = right;
					tx2Cnt(left) = tx2Cnt(left) - 1;  
				end;
				else
				do;
					if tx2Right(tx2qp) <> 0 then
						tx2Cnt(tx2Right(tx2qp)) = tx2Cnt(tx2Right(tx2qp)) - 1;  
					if (nodeControlFlags and 4) <> 0 then
					do;
						tx2Left(tx2qp) = tx2Right(1);
						if boC20F then
						do;
							type = 43h - type;
							boC20F = 0;
						end;
					end;
				end;
				tx2Type(tx2qp) = type;
				tx2Right(tx2qp) = 0;
			end;
			nodeControlFlags = nodeControlMap(curOp := type);
		end;

/* ApplyStepOptimisation */
		call GetOperandValue(left, .acc, .accFlag);
		optResult = 0;
		i = TRUE;

		do while i;
			if (curStepActions := b50AD(stepIdx)) = 0ffh then
				return FALSE;
			if (curStepActions and 10h) <> 0 then
			do;
				i = not ExpectedAttr(left);
				if (curStepActions and 4) <> 0 and not i then
					i = not ValidateOptimisationStep;
			end;
			else 
				i = not ValidateOptimisationStep;
			stepIdx = stepIdx + 1;  
		end;
		call ApplyTransformation;
		return TRUE;
	end ApplyStepOptimisation;

/* OptimiseExpression */
	if curOp <= T2$GT then
	do;
		if tx2Type(tx2qp+1) = T2$JMPFALSE and tx2Cnt(tx2qp) = 1 then
		do;
			tx2Type(tx2qp + 1) = T2$JNZ;
			tx2Left(tx2qp + 1) = tx2Right(1);
			if boC20F then
			do;
				tx2Right(tx2qp + 1) = bC209(curOp);
				boC20F = 0;
			end;
			else
				tx2Right(tx2qp + 1) = curOp;
			tx2Cnt(tx2qp) = 0;
		end;
		else
			tx2Type(tx2qp), curOp = curOp + 26h;
	end;
	else if ApplyStepOptimisation(optimisationStep1Map(curOp), tx2Right(tx2qp), tx2Left(tx2qp)) then
		;
	else if ApplyStepOptimisation(optimisationStep2Map(curOp), tx2Left(tx2qp), tx2Right(tx2qp)) then
			;
end;


end;
