00279  1    PRINTABS: PROCEDURE(CHAR);
00280  2        DECLARE (CHAR,I,J) BYTE;
00281  2        I = CHAR = TAB AND 7 - (COLUMN AND 7);
00282  2        IF CHAR = TAB THEN CHAR = ' ';
00283  2            DO J = 0 TO I;
00284  2            CALL TTYCHAR(CHAR);
00285  3            END;
00286  2        END PRINTABS;
