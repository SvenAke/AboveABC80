00909  2            DO; DIRECTION = FORWARD; CALL MOVER;
00910  3            END;
00911  2        END WRITEOUT;
00912  1     
00913  1    CLEARMEM: PROCEDURE;
00914  2        /* CLEAR MEMORY BUFFER */
00915  2        CALL SETFF;
00916  2        CALL WRITEOUT;
00917  2        END CLEARMEM;
00918  1     
00919  1    TERMINATE: PROCEDURE;
00920  2        /* CLEAR BUFFERS */
00921  2        CALL CLEARMEM;
00922  2            DO WHILE (CHAR := GETSOURCE) <> ENDFILE;
00923  2            CALL PUTDEST(CHAR);
00924  3            END;
00925  2        CALL FINIS;
00926  2        END TERMINATE;
00927  1     
00928  1     
00929  1    INSERT: PROCEDURE;
00930  2        /* INSERT CHAR INTO MEMORY BUFFER */
00931  2        IF FRONT = BACK THEN GO TO OVERFLOW;
00932  2        MEMORY(FRONT) = CHAR; CALL INCFRONT;
00933  2        IF CHAR = LF THEN CALL INCBASE;
00934  2        END INSERT;
00935  1     
00936  1    SCANNING: PROCEDURE BYTE;
00937  2        /* READ A CHARACTER AND CHECK FOR ENDFILE OR CR */
00938  2        RETURN NOT ((CHAR := READC) = ENDFILE OR
00939  2                       (CHAR = CR AND NOT INSERTING));
00940  2        END SCANNING;
00941  1     
00942  1    COLLECT: PROCEDURE;
00943  2        /* READ COMMAND BUFFER AND INSERT CHARACTERS INTO
00944  2        SCRATCH 'TIL NEXT CONTROL-Z OR CR FOR  FIND, NEXT, JUXT, OR
00945  2        SUBSTITUTE COMMANDS - FILL AT WBE AND INCREMENT WBE SO IT
00946  2        ADDRESSES NEXT EMPTY POSITION OF SCRATCH */
00947  2        SETSCR: PROCEDURE;
00948  3            SCRATCH(WBE) = CHAR;
00949  3            IF (WBE := WBE + 1) >= SCRSIZE THEN GO TO OVERFLOW;
00950  3            END SETSCR;
00951  2            DO WHILE SCANNING;
00952  2            IF CHAR = CTLL THEN
00953  3                DO; CHAR = CR; CALL SETSCR;
00954  4                CHAR = LF;
00955  4                END;
00956  3            IF CHAR = 0 THEN GO TO BADCOM;
00957  3            CALL SETSCR;
00958  3            END;
00959  2        END COLLECT;
00960  1     
00961  1    FIND: PROCEDURE(PA,PB) BYTE;
00962  2        DECLARE (PA,PB) BYTE;
00963  2        /* FIND THE STRING IN SCRATCH STARTING AT PA AND ENDING AT PB */
00964  2        DECLARE J ADDRESS,
00965  2            (K, MATCH) BYTE;
00966  2        J = BACK ;
00967  2        MATCH = FALSE;
00968  2            DO WHILE NOT MATCH AND (MAXM > J);
00969  2            LAST,J = J + 1; /* START SCAN AT J */
00970  3            K = PA ; /* ATTEMPT STRING MATCH AT K */
00971  3                DO WHILE SCRATCH(K) = MEMORY(LAST) AND
00972  3                    NOT (MATCH := K = PB);
00973  3                /* MATCHED ONE MORE CHARACTER */
00974  3                K = K + 1; LAST = LAST + 1;
00975  4                END;
00976  3            END;
00977  2        IF MATCH THEN /* MOVE STORAGE */
00978  2            DO; LAST = LAST - 1; CALL MOVER;
00979  3            END;
00980  2        RETURN MATCH;
00981  2        END FIND;
00982  1     
00983  1    SETFIND: PROCEDURE;
00984  2        /* SETUP THE SEARCH STRING FOR F,N, AND S COMMANDS */
00985  2        WBE = 0; CALL COLLECT; WBP = WBE;
00986  2        END SETFIND;
00987  1     
00988  1    CHKFOUND: PROCEDURE;
00989  2        /* CHECK FOR FOUND STRING IN F AND S COMMANDS */
00990  2        IF NOT FIND(0,WBP) THEN /* NO MATCH */ GO TO OVERCOUNT;
00991  2        END CHKFOUND;
00992  1     
00993  1     
00994  1     
00995  1    SETRFCB: PROCEDURE;
00996  2        /* PLACE CHAR INTO READ FILE CONTROL BLOCK AND INCREMENT */
00997  2        RFCB((RBP := RBP + 1) - 1) = UCASE(CHAR);
00998  2        END SETRFCB;
00999  1     
01000  1    PRINTREL: PROCEDURE;
01001  2        CALL PRINTLINE(BASELINE+RELLINE);
01002  2        END PRINTREL;
01003  1    
01004  1    TYPELINES: PROCEDURE;
01005  2        DCL I ADDR;
01006  2        DCL C BYTE;
01007  2        CALL SETLIMITS;
01008  2        /* DISABLE THE * PROMPT */
01009  2        INSERTING = TRUE;
01010  2        IF DIRECTION = FORWARD THEN
01011  2            DO; RELLINE = 0; I = FRONT;
01012  3            END; ELSE
01013  2            I = FIRST;
01014  2        IF (C := MEMORY(I-1)) = LF AND COLUMN <> 0 THEN
01015  2            CALL CRLF;
01016  2            DO I = FIRST TO LAST;
01017  2            IF C = LF THEN
01018  3                DO;
01019  3                CALL PRINTREL;
01020  4                RELLINE = RELLINE + 1;
01021  4                IF BREAK$KEY THEN GO TO OVERCOUNT;
01022  4                END;
01023  3            CALL PRINTC(C:=MEMORY(I));
01024  3            END;
01025  2        END TYPELINES;
01026  1     
01027  1    SETLPP: PROCEDURE;
01028  2        /* SET DISTANCE TO LINES PER PAGE */
01029  2        DISTANCE = LPP;
01030  2        END SETLPP;
01031  1     
01032  1    SAVEDIST: PROCEDURE;
01033  2        TDIST = DISTANCE;
01034  2        END SAVEDIST;
01035  1     
01036  1    RESTDIST: PROCEDURE;
01037  2        DISTANCE = TDIST;
01038  2        END RESTDIST;
01039  1     
01040  1    PAGE: PROCEDURE;
01041  2        DECLARE I BYTE;
01042  2        CALL SAVEDIST;
01043  2        CALL SETLPP;
01044  2        CALL MOVELINES;
01045  2        I = DIRECTION;
01046  2        DIRECTION = FORWARD;
01047  2        CALL SETLPP;
01048  2        CALL TYPELINES;
01049  2        DIRECTION = I;
01050  2        IF LAST = MAXM OR FIRST = 1 THEN CALL ZERODIST;
01051  2            ELSE CALL RESTDIST;
01052  2        END PAGE;
01053  1     
01054  1    WAIT: PROCEDURE;
01055  2        /* 1/2 SECOND TIME OUT */
01056  2        DECLARE I BYTE;
01057  2            DO I = 0 TO 19;
01058  2            IF BREAK$KEY THEN GO TO RESET;
01059  3            CALL TIME(250);
01060  3            END;
01061  2        END WAIT;
01062  1     
01063  1    SETFORWARD: PROCEDURE;
01064  2        DIRECTION = FORWARD;
01065  2        DISTANCE = 1;
01066  2        END SETFORWARD;
01067  1     
01068  1    APPHALF: PROCEDURE;
01069  2        /* APPEND 'TIL BUFFER IS AT LEAST HALF FULL */
01070  2        CALL SETFF; /* DISTANCE = 0FFFFH */
01071  2            DO WHILE DISTNZERO;
01072  2            IF FRONT >= HMAX THEN CALL ZERODIST; ELSE
01073  3            CALL READLINE;
01074  3            END;
01075  2        END APPHALF;
01076  1     
01077  1    INSCRLF: PROCEDURE;
01078  2        /* INSERT CR LF CHARACTERS */
01079  2        CHAR = CR; CALL INSERT;
01080  2        CHAR = LF; CALL INSERT;
01081  2        END INSCRLF;
01082  1     
01083  1    TESTCASE: PROCEDURE;
01084  2        DECLARE T BYTE;
01085  2        /* TEST FOR UPPER OR LOWER CASE COMMAND AND SET TRANSLATE
01086  2        FLAG (USED TO DETERMINE IF CHARACTERS WHICH FOLLOW GO TO UPPER */
01087  2        TRANSLATE = TRUE;
01088  2        T = LOWERCASE(CHAR);
01089  2        CHAR = UTRAN(CHAR);
01090  2        TRANSLATE = UPPER OR NOT T;
01091  2        END TESTCASE;
01092  1     
01093  1    READCTRAN: PROCEDURE;
01094  2        /* SET TRANSLATE TO FALSE AND READ NEXT CHARACTER */
01095  2        TRANSLATE = FALSE;
01096  2        CHAR = READC;
01097  2        CALL TESTCASE;
01098  2        END READCTRAN;
01099  1     
01100  1    SINGLECOM: PROCEDURE(C) BYTE;
01101  2        /* RETURN TRUE IF COMMAND IS ONLY CHARACTER, NOT IN MACRO */
01102  2        DECLARE C BYTE;
01103  2        RETURN CHAR = C AND COMLEN = 1 AND MP = 0;
01104  2        END SINGLECOM;
01105  1     
01106  1    SINGLERCOM: PROCEDURE(C) BYTE;
01107  2        DECLARE C BYTE;
01108  2        /* RETURN TRUE IF COMMAND IS ONLY CHARACTER, NOT IN MACRO, AND
01109  2        THE OPERATOR HAS RESPONDED WITH 'Y' TO A Y/N REQUEST */
01110  2        IF SINGLECOM(C) THEN
01111  2            DO; CALL CRLF; CALL PRINTCHAR(C);
01112  3            CALL MON1(9,.('-(Y/N)',WHAT,'$'));
01113  3            C = UCASE(READCHAR); CALL CRLF;
01114  3            IF C <> 'Y' THEN GO TO START;
01115  3            RETURN TRUE;
01116  3            END;
01117  2        RETURN FALSE;
01118  2        END SINGLERCOM;
