00263  1    TTYCHAR: PROCEDURE(CHAR);
00264  2        DECLARE CHAR BYTE;
00265  2        IF CHAR >= ' ' THEN COLUMN = COLUMN + 1;
00266  2        IF CHAR = LF THEN COLUMN = 0;
00267  2        CALL PRINTCHAR(CHAR);
00268  2        END TTYCHAR;
00269  1     
00270  1    BACKSPACE: PROCEDURE;
00271  2        /* MOVE BACK ONE POSITION */
00272  2        IF COLUMN = 0 THEN RETURN;
00273  2        CALL TTYCHAR(CTLH); /* COLUMN = COLUMN - 1 */
00274  2        CALL TTYCHAR(' ' ); /* COLUMN = COLUMN + 1 */
00275  2        CALL TTYCHAR(CTLH); /* COLUMN = COLUMN - 1 */
00276  2        COLUMN = COLUMN - 2;
00277  2        END BACKSPACE;
